datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  profile       Profile?

  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  about     String?
  avatar    String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("refresh_tokens")
}

enum BookStatus {
  PUBLISHED
  UNPUBLISHED
}

model Book {
  id             String          @id @default(cuid())
  name           String
  author         String
  description    String
  sellingPrice   Float
  costPrice      Float
  releaseDate    DateTime
  status         BookStatus      @default(UNPUBLISHED)
  coverImage     String?
  categories     Category[]
  sales          Sale[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("books")
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  books Book[]

  @@map("categories")
}

model Sale {
  id            String         @id @default(cuid())
  city          String
  soldAt        DateTime
  revenue       Float
  bookId        String
  book          Book           @relation(fields: [bookId], references: [id])
  stockMovement StockMovement?
  createdAt     DateTime       @default(now())

  @@map("sales")
}

enum StockMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id        String            @id @default(cuid())
  bookId    String
  book      Book              @relation(fields: [bookId], references: [id])
  quantity  Int
  type      StockMovementType
  note      String?
  saleId    String?           @unique
  sale      Sale?             @relation(fields: [saleId], references: [id])
  createdAt DateTime          @default(now())

  @@index([bookId])
  @@map("stock_movements")
}
